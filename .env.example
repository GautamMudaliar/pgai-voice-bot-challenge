# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Created by src/setup_agent.py on first run, or created manually in the
# ElevenLabs dashboard under Agents Platform > Agents. Paste the resulting
# agent_id here.
ELEVENLABS_AGENT_ID=your_agent_id_here

# The phone_number_id of the Twilio number you imported into ElevenLabs
# (Agents Platform > Phone Numbers). This is the number your bot calls FROM.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=your_agent_phone_number_id_here

# Used by src/bug_analyzer.py to review transcripts for issues
OPENAI_API_KEY=your_openai_api_key_here

# The single phone number you are using for ALL test calls in this challenge,
# in E.164 format. This should match what you submit in the assessment form.
CALLER_NUMBER=+1XXXXXXXXXX
