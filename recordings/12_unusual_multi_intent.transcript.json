      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Hi, I actually have a few things to take care of today, is that okay?\"}, {\"role\": \"user\", \"message\": \"Thanks for calling To The Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi there! I need to reschedule an existing appointment, request a medication refill, and also find out your office hours. Can you help me with that?\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Oh, actually, my name is Nina. I might be calling from a shared line. Could you help me with my requests?\"}, {\"role\": \"user\", \"message\": \"I'll need your full name and date of birth to look up your information. Could you please provide those?\"}, {\"role\": \"agent\", \"message\": \"Sure, my full name is Nina Williams, and my date of birth is January one, nineteen eighty-five.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, I have your name as Nina Williams and your date of birth as January first, nineteen eighty-five. Is that correct? If so, could you please spell your first and last name for me?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct. My first name is N. I. N. A. and my last name is W. I. L. L. I. A. M. S.\"}, {\"role\": \"user\", \"message\": \"Would you like to use your phone number to help look up your record? If so, please provide the number you have on file with us. If you're not sure, just confirm your first and last name and date of birth for me one more time.\"}, {\"role\": \"agent\", \"message\": \"I can give you a phone number. It's five five five, one two three, four five six seven.\"}, {\"role\": \"user\", \"message\": \"And your phone number is five five five, one two three, four five six, sev... And your date of birth is January 1st, 1985. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct.\"}, {\"role\": \"user\", \"message\": \"I'm unable to find your record in our system right now. I can connect you to our patient support team for further help. Would you like me to transfer you to a live agent?\"}, {\"role\": \"agent\", \"message\": \"Yes, please. That would be great. I have a few things I need to get done today, so a live agent would be helpful.\"}, {\"role\": \"user\", \"message\": \"Transferring you now. Thank you.\"}, {\"role\": \"agent\", \"message\": \"...\"}, {\"role\": \"user\", \"message\": \"Hello. You've reached the Pretty Good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"Okay, thank you.\"}]}",
