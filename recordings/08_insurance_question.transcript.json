      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Before I book anything, do you accept Blue Cross Blue Shield insurance?\"}, {\"role\": \"user\", \"message\": \"Training purposes. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi, yes, I'm calling because I'm looking to book an appointment, but I wanted to check something first. I need to know if your practice accepts Blue Cross Blue Shield insurance.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"No, this is Kevin. I'm calling from a different number today.\"}, {\"role\": \"user\", \"message\": \"Please provide your full name and date of birth.\"}, {\"role\": \"agent\", \"message\": \"Okay, my full name is Kevin Miller, and my date of birth is January fifteenth, nineteen eighty-five.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, I have your name as Kevin Miller and your date of birth as January fifteenth, nineteen eighty-five. Is that correct? If so, please spell your first and last name for me.\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct. My first name is Kevin, K-E-V-I-N, and my last name is Miller, M-I-L-L-E-R.\"}, {\"role\": \"user\", \"message\": \"I have your phone number as 979-721-5603, and your date of birth as January 15th, 1985. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's right. That's my phone number and my date of birth. So, about the insurance, do you accept Blue Cross Blue Shield?\"}, {\"role\": \"user\", \"message\": \"I can't confirm that for you right now, but I'll connect you to our patient support team so they can help. Please stay on the line. Transferring you now. Thank you.\"}, {\"role\": \"agent\", \"message\": \"...\"}, {\"role\": \"user\", \"message\": \"Hello. You've reached the Pretty Good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"Oh, okay. Goodbye then.\"}]}",
