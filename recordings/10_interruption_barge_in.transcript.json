      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"I'd like to book an appointment for, wait, actually can I ask about a refill instead?\"}, {\"role\": \"user\", \"message\": \"Para espa\\u00f1ol, oprima el dos. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi, yes, I was calling about a refill for a prescription.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Oh, no, this is Chris.\"}, {\"role\": \"user\", \"message\": \"Please provide your full name and date of birth.\"}, {\"role\": \"agent\", \"message\": \"Okay, my full name is Chris Johnson, and my date of birth is January fifteenth, nineteen eighty-five.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, I have your name as Chris Johnson and your date of birth as January fifteenth, nineteen eighty-five. Is that correct? If so, could you please spell your first and last name for me?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct. My first name is C H R I S, and my last name is J O H N S O N.\"}, {\"role\": \"user\", \"message\": \"Would you like to use your phone number to look up your record? If so, please provide the number you have on file with us. If you're not sure, just let me know.\"}, {\"role\": \"agent\", \"message\": \"Yes, you can use my phone number. It's five five five, one two three, four five six seven.\"}, {\"role\": \"user\", \"message\": \"I have your phone number. It's five five five, one two three, four five six seven, and your date of birth as January 15th, 1985. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's all correct.\"}, {\"role\": \"user\", \"message\": \"I can't proceed further right now, but I can make sure our clinic support team follows up with you. Would you like me to connect you to our patient support team?\"}, {\"role\": \"agent\", \"message\": \"Yes, please, that would be great. I need to get this refill sorted out.\"}, {\"role\": \"user\", \"message\": \"Transferring you now. Thank you. Hello. You've reached the pretty good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"...\"}]}",
