      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Hi, I need to reschedule an appointment I already have booked.\"}, {\"role\": \"user\", \"message\": \"Quality and training purposes. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi, I'm David. I have an appointment this Thursday at two in the afternoon, but I need to move it to sometime next week because of a work conflict. Could you help me with that, please?\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Oh, no, I'm sorry. My name is David. I'm calling about my appointment.\"}, {\"role\": \"user\", \"message\": \"No problem, David. Please provide your full name and date of birth.\"}, {\"role\": \"agent\", \"message\": \"Sure, my full name is David Miller, and my date of...\"}, {\"role\": \"user\", \"message\": \"Could you please...\"}, {\"role\": \"agent\", \"message\": \"Oh, sorry. My full name is David Miller, and my date of birth is January first, nineteen eighty-five.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, I have your name as David Miller and your date of birth as January first, nineteen eighty-five. Is that correct? If so, could you please spell your first and last name for me?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct. My first name is David, D-A-V-I-D, and my last name is Miller, M-I-L-L-E-R.\"}, {\"role\": \"user\", \"message\": \"Would you like to use your phone number to look up your record? If so, please provide the number you have on file with us. If you're not sure, I can confirm your name and date of birth again. Let me know what you prefer.\"}, {\"role\": \"agent\", \"message\": \"Yes, please use the phone number I'm calling from. It's five five five, one two three, four five six seven.\"}, {\"role\": \"user\", \"message\": \"I have your number as five five five, one two three, four five six seven. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct. That's the number.\"}, {\"role\": \"user\", \"message\": \"I'm unable to find your record in our system. I can connect you to our patient support team for help with your appointment. Please stay on the line while I transfer you. Transferring you now. Thank you. Hello. You've reached the Pretty Good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"Oh, it sounds like the call ended. I didn't get to reschedule my appointment.\"}]}",
