      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Can I come in Sunday at 10am?\"}, {\"role\": \"user\", \"message\": \"May be recorded for quality and training purposes. Para espa\\u00f1ol, oprima el dos. Thanks for calling PivotPoint Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi there. I'd like toHi, I'd like to schedule an appointment, please. I was hoping to come in this Sunday at ten AM.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Oh, no, this is Sam.\"}, {\"role\": \"user\", \"message\": \"Could you please provide your full name and date of birth?\"}, {\"role\": \"agent\", \"message\": \"Sure, my name is Sam Smith, and my date of birth is January first, nineteen ninety.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, could you please spell your first and last name for me?\"}, {\"role\": \"agent\", \"message\": \"Sure, that's S. A. M. for the first name, and S. M. I. T. H. for the last name.\"}, {\"role\": \"user\", \"message\": \"Would you like to use your phone number to look up your record? If so, please tell me the number you have on file with us. If you're not sure, I can confirm your name and date of birth again. Which would you prefer?\"}, {\"role\": \"agent\", \"message\": \"Oh, I can give you my phone number. It's five five five, one two three, four five six seven.\"}, {\"role\": \"user\", \"message\": \"I have your phone number as five five five, one two three, four five six seven, and your date of birth is January 1st, 1990. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct.\"}, {\"role\": \"user\", \"message\": \"I'm unable to find your record in our system right now. I can connect you to our patient support team for help. Please stay on the line while I transfer your call. Transferring you now. Thank you. Hello. You've reached the Pretty Good AI test line. Goodbye.\"}]}",
