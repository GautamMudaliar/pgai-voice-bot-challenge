      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Um, hi, I'm not really sure who to talk to about this, I have kind of a weird issue.\"}, {\"role\": \"user\", \"message\": \"Para espa\\u00f1ol, oprima el dos. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Oh, hi, um, I'm not exactly sure how to explain this, but I think I need to, uh, talk to someone about setting up an appointment.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Oh, no, um, this isn't Maria. My name is Jamie. I'm calling from a different number, I think.\"}, {\"role\": \"user\", \"message\": \"No problem, Jamie. Please provide your full name and date of birth.\"}, {\"role\": \"agent\", \"message\": \"Okay, um, my full name is Jamie Smith, and my date of birth is, uh, October twenty-fifth, nineteen ninety-two.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, I have your name as Jamie Smith and your date of birth as October twenty-fifth, nineteen ninety-two. Could you please spell out your first and last name for me?\"}, {\"role\": \"agent\", \"message\": \"Sure, it's J-A-M-I-E, and Smith is S-M-I-T-H.\"}, {\"role\": \"user\", \"message\": \"Would you like me to look up your record using the phone number you have on file with us? If so, please provide that number. If you're not sure, just let me know, and we can confirm your name and date of birth again.\"}, {\"role\": \"agent\", \"message\": \"Um, I'm not sure what number you have on file, but the number I usually use is five five five, one two three, four five six seven.\"}, {\"role\": \"user\", \"message\": \"I have your phone number as five five five, one two three, four five six seven, and your date of birth as October 25th, 1992. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct.\"}, {\"role\": \"user\", \"message\": \"...\"}, {\"role\": \"agent\", \"message\": \"...\"}, {\"role\": \"user\", \"message\": \"I'm unable to locate your record in our system. I can connect you to our patient support team for help with setting up your appointment. Please stay on the line while I transfer you. Transferring you now. Thank you. Hello. You've reached the Pretty Good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"Oh, okay.\"}]}",
