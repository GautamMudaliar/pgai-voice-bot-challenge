      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Hi, I need a refill on one of my prescriptions.\"}, {\"role\": \"user\", \"message\": \"Recorded for quality and training purposes. Para espa\\u00f1ol, oprima el dos. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Oh, hi. Yeah, I need a refill on one of my prescriptions. I'm almost out of my maintenance medication.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Oh, no, no, no. This is Robert. My name is Robert.\"}, {\"role\": \"user\", \"message\": \"Please provide your full name and date of birth.\"}, {\"role\": \"agent\", \"message\": \"Okay, yeah. My full name is Robert Johnson. And my date of birth is, uh, January first, nineteen seventy-five.\"}, {\"role\": \"user\", \"message\": \"...\"}, {\"role\": \"agent\", \"message\": \"Hello? Are you still there?\"}, {\"role\": \"user\", \"message\": \"Yes, I'm here. Just to confirm, your name is Robert Johnson, and your date of birth is January 1st, 1975. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yeah, that's right. Robert Johnson, January first, nineteen seventy-five. So, about that refill, I'm really running low on my maintenance medication. Can you help me with that?\"}, {\"role\": \"user\", \"message\": \"Would you like me to look up your record using the phone number you have on file with us? If so, please tell me the number you use with our office. If you're not sure I can confirm your name and date of birth again, just let me know.\"}, {\"role\": \"agent\", \"message\": \"Oh, yeah, you can just use the number I'm calling from. That's the one you have on file. So, about my medication, I'm really almost out.\"}, {\"role\": \"user\", \"message\": \"I have your phone number as 979-721-5603, and your date of birth is January 1st, 1975. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct. That's my number and date of birth. Can you help me with the refill now?\"}, {\"role\": \"user\", \"message\": \"I can't proceed further right now, but I can make sure our clinic support team follows up with you about your medication refill. Would you like me to connect you to our patient support team?\"}, {\"role\": \"agent\", \"message\": \"Uh, yeah, yeah, please connect me. I really need to get this refill sorted out. I'm almost completely out of my maintenance medication.\"}, {\"role\": \"user\", \"message\": \"Transferring you now. Thank you. Hello. You've reached the Pretty Good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"Oh, okay. Thank you.\"}]}",
