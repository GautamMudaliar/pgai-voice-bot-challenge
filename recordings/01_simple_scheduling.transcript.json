      "system__call_sid": "CA80c2b1b7b2ab40dc206dd6e7abe10db7",
      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"Hi, I'd like to schedule a checkup appointment for next week.\"}, {\"role\": \"user\", \"message\": \"... quality and training purposes. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi, yes, I'd like to schedule a routine checkup appointment, please.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's me. Maria.\"}, {\"role\": \"user\", \"message\": \"Please provide your date of birth.\"}, {\"role\": \"agent\", \"message\": \"Okay, my date of birth is January fifteen, nineteen eighty-five.\"}, {\"role\": \"user\", \"message\": \"...\"}, {\"role\": \"agent\", \"message\": \"Hello? Are you still there?\"}, {\"role\": \"user\", \"message\": \"Yes, I'm here. You mentioned wanting a routine checkup. Just to confirm, you'd like to book a general office visit for a routine checkup, correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's right. A routine checkup.\"}, {\"role\": \"user\", \"message\": \"Do you have a specific provider you'd like to see, or are you open to any available provider?\"}, {\"role\": \"agent\", \"message\": \"I'm open to any available provider.\"}, {\"role\": \"user\", \"message\": \"You already have a routine office visit scheduled for Monday, August 17th at 2:00 p.m. Would you like to keep this appointment, reschedule it, or cancel it?\"}, {\"role\": \"agent\", \"message\": \"Oh, I must have forgotten about that. I'll keep the appointment for Monday, August seventeenth at two p.m. Thank you. Could you let me know what I need to bring?\"}, {\"role\": \"user\", \"message\": \"For your appointment, please bring a photo ID, your insurance card, and a list of any medications you're taking. If you have recent medical records or imaging related to your condition, those can be helpful too. If you have any other questions, just let me know.\"}, {\"role\": \"agent\", \"message\": \"Okay, great. So, I'll bring my photo ID, insurance card, and a list of medications. And the appointment is on Monday, August seventeenth, at two p.m. Is there anything else I need to know?\"}, {\"role\": \"user\", \"message\": \"That covers everything important. Your appointment is Monday, August seventeenth, at two p.m. If you have any new symptoms or need to reschedule, just give us a call. We look forward to seeing you.\"}, {\"role\": \"agent\", \"message\": \"Okay, perfect. Thank you so much for your help. I'll see you then.\"}, {\"role\": \"user\", \"message\": \"You're all set, Maria. Have a great day, and we'll see you at your appointment.\"}]}",
