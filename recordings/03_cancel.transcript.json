      "system__conversation_history": "{\"x-elevenlabs-history\": true, \"entries\": [{\"role\": \"agent\", \"message\": \"I need to cancel my upcoming appointment, please.\"}, {\"role\": \"user\", \"message\": \"... for quality and training purposes. Thanks for calling Pivot Point Orthopedics, part of Pretty Good AI. How may I help you today?\"}, {\"role\": \"agent\", \"message\": \"Hi, I need to cancel an upcoming appointment.\"}, {\"role\": \"user\", \"message\": \"I see you're calling from the number we have on file. Am I speaking with Maria?\"}, {\"role\": \"agent\", \"message\": \"No, this is Angela.\"}, {\"role\": \"user\", \"message\": \"Please provide your full name and date of birth.\"}, {\"role\": \"agent\", \"message\": \"My name is Angela Smith, and my date of birth is January first, nineteen eighty-five.\"}, {\"role\": \"user\", \"message\": \"Just to confirm, I have your name as Angela Smith and your date of birth as January first, nineteen eighty-five. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's correct.\"}, {\"role\": \"user\", \"message\": \"Would you like me to look up your record using the phone number you have on file with us? If so, please provide that number. If you're not sure, I can confirm your name and date of birth again. Just let me know.\"}, {\"role\": \"agent\", \"message\": \"Yes, please use the phone number I'm calling from. It's five five five, one two three, four five six seven.\"}, {\"role\": \"user\", \"message\": \"I have your phone number as five five five, one two three, four five six seven, and your date of birth is January 1st, 1985. Is that correct?\"}, {\"role\": \"agent\", \"message\": \"Yes, that's all correct.\"}, {\"role\": \"user\", \"message\": \"...\"}, {\"role\": \"agent\", \"message\": \"Hello? Are you still there?\"}, {\"role\": \"user\", \"message\": \"I'm here. I'm unable to find your record in our system, so I can't cancel your appointment right now. I'll connect you to our patient support team for help. Please stay on the line. Transferring you now. Thank you.\"}, {\"role\": \"agent\", \"message\": \"Okay, thank you. I'll...\"}, {\"role\": \"user\", \"message\": \"Hello. You've reached the Pretty Good AI test line. Goodbye.\"}, {\"role\": \"agent\", \"message\": \"It seems the call ended abruptly. I was trying to cancel my appointment, but I wasn't able to complete that task.\"}]}",
